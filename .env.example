# API (api/ e server/) - configure credenciais administrativas somente no painel da Render.
SUPABASE_SERVICE_ROLE_KEY=CONFIGURE_NO_RENDER
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_PROJECT_ID=SEU_PROJECT_ID_PARA_DB_TYPES
MANUTENCAO_SOURCE_URL=https://SEU_SITE_DE_MANUTENCAO/
RENEA_PUBLIC_TICKET_LINK_TOKEN=TOKEN_ALEATORIO_COM_PELO_MENOS_24_CARACTERES
SENTRY_DSN=

# Frontend (somente variáveis públicas VITE_*)
VITE_CLOUD_PROVIDER=supabase
VITE_SUPABASE_URL=https://SEU_PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=SUBSTITUA_PELA_CHAVE_PUBLICAVEL
VITE_SUPABASE_ORGANIZATION_ID=renea
VITE_SUPABASE_OPERATIONAL_ATTACHMENTS_BUCKET=operational-attachments
VITE_SENTRY_DSN=

# Nunca exponha SUPABASE_SERVICE_ROLE_KEY ou segredos em variáveis VITE_* ou no navegador.
